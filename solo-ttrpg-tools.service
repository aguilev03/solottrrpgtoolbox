[Unit]
Description=Solo TTRPG Tools Web Application
After=network.target

[Service]
Type=notify
# Change User and Group to match your Debian LXC user (e.g., www-data, debian, or your username)
User=www-data
Group=www-data
WorkingDirectory=/opt/solo-ttrpg-tools
Environment="PATH=/opt/solo-ttrpg-tools/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PORT=8080"
Environment="HOST=0.0.0.0"
Environment="DEBUG_DUNGEON_ROLLS=false"

# Production execution with Gunicorn (3 worker processes)
ExecStart=/opt/solo-ttrpg-tools/.venv/bin/gunicorn \
    --workers 3 \
    --bind 0.0.0.0:8080 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
