[Unit]
Description=Solo TTRPG Tools Web Application
After=network.target

[Service]
Type=simple
# User and Group matching your Debian LXC
User=hexroll
Group=hexroll
WorkingDirectory=/home/hexroll/solottrrpgtoolbox
Environment="PATH=/home/hexroll/solottrrpgtoolbox/.venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PORT=5000"
Environment="HOST=127.0.0.1"
Environment="DEBUG_DUNGEON_ROLLS=false"

# Production execution with Gunicorn (3 worker processes) bound to internal 127.0.0.1:5000
ExecStart=/home/hexroll/solottrrpgtoolbox/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:5000 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
